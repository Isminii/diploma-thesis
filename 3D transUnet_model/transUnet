
import torch
import torch.nn as nn
from einops import rearrange
import math

# Custom weight initialization function
def initialize_weights(module):
    if isinstance(module, nn.Conv3d) or isinstance(module, nn.ConvTranspose3d):
        # Initialize convolutional and transposed convolutional layers
        if module.weight is not None:
            nn.init.kaiming_normal_(module.weight, mode='fan_out', nonlinearity='relu')
        if module.bias is not None:
            nn.init.constant_(module.bias, 0)
    elif isinstance(module, nn.Linear):
        # Initialize linear layers
        if module.weight is not None:
            nn.init.xavier_uniform_(module.weight)
        if module.bias is not None:
            nn.init.constant_(module.bias, 0)
    elif isinstance(module, nn.InstanceNorm3d) or isinstance(module, nn.BatchNorm3d):
        # Initialize normalization layers if they have weights and biases
        if module.weight is not None:
            nn.init.constant_(module.weight, 1)
        if module.bias is not None:
            nn.init.constant_(module.bias, 0)
    elif isinstance(module, nn.LayerNorm):
        # Initialize layer normalization layers
        if module.weight is not None:
            nn.init.constant_(module.weight, 1)
        if module.bias is not None:
            nn.init.constant_(module.bias, 0)

# Transformer Block for 3D inputs with residual connection across block
class TransformerBlock(nn.Module):
    def __init__(self, dim, heads, dim_head, mlp_dim, dropout=0.1):
        super().__init__()
        self.norm1 = nn.LayerNorm(dim)
        self.attn = nn.MultiheadAttention(dim, heads, dropout=dropout, batch_first=True)
        self.norm2 = nn.LayerNorm(dim)
        self.ff = nn.Sequential(
            nn.Linear(dim, mlp_dim),
            nn.GELU(),
            nn.Linear(mlp_dim, dim),
            nn.Dropout(dropout)
        )

    def forward(self, x):
        residual = x.clone()  # Add residual connection across the transformer block
        x = self.norm1(x)
        attn_out, _ = self.attn(x, x, x)
        x = attn_out + residual  # Residual connection after attention
        x = self.norm2(x)
        ff_out = self.ff(x)
        return ff_out + x  # Residual connection after feed-forward


class LearnedPositionalEmbedding3D(nn.Module):
    def __init__(self, embed_dim, input_shape):
        super().__init__()
        d, h, w = input_shape
        self.num_patches = d * h * w  # Calculate the total number of patches
        self.embed_dim = embed_dim

        # Create positional embedding
        self.pos_embedding = nn.Parameter(torch.randn(1, self.num_patches, embed_dim))

    def forward(self, x, num_patches):
        # Ensure the embedding matches the input shape
        return x + self.pos_embedding[:, :num_patches, :]
    
# Transformer Encoder for 3D data
class TransformerEncoder3D(nn.Module):
    def __init__(self, embed_dim, depth, heads, mlp_dim, dim_head=32, dropout=0.1):
        super().__init__()
        self.layers = nn.ModuleList([TransformerBlock(embed_dim, heads, dim_head, mlp_dim, dropout) for _ in range(depth)])

    def forward(self, x):
        residual = x.clone()
        for layer in self.layers:
            x = layer(x)
        return x + residual  # Residual connection across transformer layers

# 3D U-Net Encoder with 4 downsampling stages
class UNetEncoder3D(nn.Module):
    def __init__(self, in_channels, base_channels):
        super().__init__()
        self.enc1 = nn.Sequential(
            nn.Conv3d(in_channels, base_channels, 3, padding=1),
            nn.InstanceNorm3d(base_channels),
            nn.ReLU(),
            nn.Conv3d(base_channels, base_channels, 3, padding=1),
            nn.InstanceNorm3d(base_channels),
            nn.ReLU()
        )
        self.enc2 = nn.Sequential(
            nn.Conv3d(base_channels, base_channels*2, 3, padding=1),
            nn.InstanceNorm3d(base_channels*2),
            nn.ReLU(),
            nn.Conv3d(base_channels*2, base_channels*2, 3, padding=1),
            nn.InstanceNorm3d(base_channels*2),
            nn.ReLU()
        )
        self.enc3 = nn.Sequential(
            nn.Conv3d(base_channels*2, base_channels*4, 3, padding=1),
            nn.InstanceNorm3d(base_channels*4),
            nn.ReLU(),
            nn.Conv3d(base_channels*4, base_channels*4, 3, padding=1),
            nn.InstanceNorm3d(base_channels*4),
            nn.ReLU()
        )
        self.enc4 = nn.Sequential(
            nn.Conv3d(base_channels*4, base_channels*8, 3, padding=1),
            nn.InstanceNorm3d(base_channels*8),
            nn.ReLU(),
            nn.Conv3d(base_channels*8, base_channels*8, 3, padding=1),
            nn.InstanceNorm3d(base_channels*8),
            nn.ReLU()
        )
        self.pool = nn.MaxPool3d(2)

    def forward(self, x):
        enc1_out = self.enc1(x)
        enc1_pooled = self.pool(enc1_out)
        enc2_out = self.enc2(enc1_pooled)
        enc2_pooled = self.pool(enc2_out)
        enc3_out = self.enc3(enc2_pooled)
        enc3_pooled = self.pool(enc3_out)
        enc4_out = self.enc4(enc3_pooled)
        return enc4_out, enc3_out, enc2_out, enc1_out

# Decoder for 3D U-Net with 4 upsampling stages
class UNetDecoder3D(nn.Module):
    def __init__(self, base_channels, num_classes):
        super().__init__()
        self.init_conv = nn.Sequential(
            nn.Conv3d(base_channels * 8, base_channels * 8, 3, padding=1),
            nn.InstanceNorm3d(base_channels * 8),
            nn.ReLU(),
            nn.Conv3d(base_channels * 8, base_channels * 8, 3, padding=1),
            nn.InstanceNorm3d(base_channels * 8),
            nn.ReLU()
        )

        self.upconv4 = nn.ConvTranspose3d(base_channels * 8, base_channels * 8, 2, stride=2)
        self.concat_conv4 = nn.Conv3d(base_channels * 8 + base_channels * 4, base_channels * 4, kernel_size=3, padding=1)
        self.dec4 = nn.Sequential(
            nn.InstanceNorm3d(base_channels * 4),
            nn.ReLU(),
            nn.Conv3d(base_channels * 4, base_channels * 4, 3, padding=1),
            nn.InstanceNorm3d(base_channels * 4),
            nn.ReLU()
        )

        self.upconv3 = nn.ConvTranspose3d(base_channels * 4, base_channels * 4, 2, stride=2)
        self.concat_conv3 = nn.Conv3d(base_channels * 4 + base_channels * 2, base_channels * 2, kernel_size=3, padding=1)
        self.dec3 = nn.Sequential(
            nn.InstanceNorm3d(base_channels * 2),
            nn.ReLU(),
            nn.Conv3d(base_channels * 2, base_channels * 2, 3, padding=1),
            nn.InstanceNorm3d(base_channels * 2),
            nn.ReLU()
        )

        self.upconv2 = nn.ConvTranspose3d(base_channels * 2, base_channels * 2, 2, stride=2)
        self.concat_conv2 = nn.Conv3d(base_channels * 2 + base_channels, base_channels, kernel_size=3, padding=1)
        self.dec2 = nn.Sequential(
            nn.InstanceNorm3d(base_channels),
            nn.ReLU(),
            nn.Conv3d(base_channels, base_channels, 3, padding=1),
            nn.InstanceNorm3d(base_channels),
            nn.ReLU()
        )

        self.final_conv = nn.Conv3d(base_channels, num_classes, 1)

    def forward(self, x, enc3_out, enc2_out, enc1_out):
        x = self.init_conv(x)

        x = self.upconv4(x)
        x = torch.cat([x, enc3_out], dim=1)
        x = self.concat_conv4(x)
        x = self.dec4(x)

        x = self.upconv3(x)
        x = torch.cat([x, enc2_out], dim=1)
        x = self.concat_conv3(x)
        x = self.dec3(x)

        x = self.upconv2(x)
        x = torch.cat([x, enc1_out], dim=1)
        x = self.concat_conv2(x)
        x = self.dec2(x)

        return self.final_conv(x)

# 3D TransUNet Model with Transformer Skip Connections
class TransUNet3D(nn.Module):
    def __init__(self, in_channels, base_channels, img_shape, embed_dim, depth, heads, mlp_dim, num_classes=4, dropout=0.1):
        super().__init__()
        self.encoder = UNetEncoder3D(in_channels, base_channels)
        self.transformer_input_proj = nn.Sequential(
            nn.Conv3d(base_channels * 8, embed_dim, kernel_size=1),
            nn.ReLU(inplace=True),
            nn.Conv3d(embed_dim, embed_dim, kernel_size=1)
        )
        d, h, w = img_shape
        self.pos_emb = LearnedPositionalEmbedding3D(embed_dim, (d // 8, h // 8, w // 8))
        self.transformer = TransformerEncoder3D(embed_dim, depth, heads, mlp_dim, dropout)
        self.transformer_output_proj = nn.Sequential(
            nn.Conv3d(embed_dim, base_channels * 8, kernel_size=1),
            nn.ReLU(inplace=True),
            nn.Conv3d(base_channels * 8, base_channels * 8, kernel_size=1)
        )
        self.decoder = UNetDecoder3D(base_channels, num_classes)
        self.apply(initialize_weights)

    def forward(self, x):
        enc4_out, enc3_out, enc2_out, enc1_out = self.encoder(x)

        # Project encoder output to transformer input
        transformer_input = self.transformer_input_proj(enc4_out)

        # Reshape for transformer input (B, C, D, H, W) -> (B, D*H*W, C)
        B, C, D, H, W = transformer_input.shape
        x = rearrange(transformer_input, 'b c d h w -> b (d h w) c')

        # Calculate the number of patches correctly
        num_patches = D * H * W  # This should match the positional embedding dimension
        x = self.pos_emb(x, num_patches)

        # Pass through transformer
        transformer_out = self.transformer(x)

        # Reshape back to (B, C, D, H, W)
        x = rearrange(transformer_out, 'b (d h w) c -> b c d h w', d=D, h=H, w=W)

        # Skip connection between transformer input and output
        x = x + transformer_input

        # Project back to original feature map size for decoder input
        x = self.transformer_output_proj(x)

        # Decode with skip connections
        return self.decoder(x, enc3_out, enc2_out, enc1_out)
